generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model users {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  password_hash   String
  nombre          String?
  session_version Int       @default(0)
  deleted_at      DateTime?
  created_at      DateTime  @default(now())
  profile         profiles?
}

model profiles {
  id                    String   @id @db.Uuid
  nombre                String
  moneda_default        String   @default("HNL")
  onboarding_completado Boolean  @default(false)
  created_at            DateTime @default(now())
  user                  users    @relation(fields: [id], references: [id], onDelete: Cascade)
}

model wallets {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @db.Uuid
  nombre         String
  tipo           String
  saldo_inicial  Decimal  @default(0) @db.Decimal(19, 4)
  color          String?
  moneda         String   @default("HNL")
  activo         Boolean  @default(true)
  credito_limite Decimal? @db.Decimal(19, 4)
  fecha_corte    Int?
  fecha_pago     Int?
  numero_cuenta  String?
  numero_tarjeta String?
  posicion       Int      @default(0)
  created_at     DateTime @default(now())

  transactions          transactions[]  @relation("wallet")
  transacciones_destino transactions[]  @relation("wallet_destino")
  debt_payments         debt_payments[]

  @@index([user_id])
}

model exchange_rates {
  id             String   @id @default(uuid()) @db.Uuid
  // null = tasa global del BCH (compartida); con valor = override manual de ese usuario.
  user_id        String?  @db.Uuid
  moneda_origen  String
  moneda_destino String
  tasa           Decimal  @db.Decimal(19, 8)
  fecha          DateTime @db.Date
  fuente         String   @default("BCH")
  created_at     DateTime @default(now())

  @@unique([moneda_origen, moneda_destino, fecha, fuente, user_id], map: "exchange_rates_par_fecha_fuente_usuario_key")
  @@index([moneda_origen, moneda_destino, fecha])
  @@index([user_id])
}

model categories {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String?  @db.Uuid
  nombre     String
  icono      String?
  color      String?
  tipo       String
  parent_id  String?  @db.Uuid
  es_sistema Boolean  @default(false)
  protegida  Boolean  @default(false)
  archivada  Boolean  @default(false)
  // Copia que solo existe para ocultarle a este usuario una predeterminada
  // global: no se muestra en ninguna parte (la descarta categoriasVisibles),
  // su único trabajo es que la original deje de aparecerle a él.
  oculta     Boolean  @default(false)
  // Copia personal de una predeterminada: al editar "Supermercado" el usuario
  // se lleva una propia y esta apunta a la global que sustituye, para que la
  // original deje de aparecerle a él (y solo a él).
  origen_id  String?  @db.Uuid
  created_at DateTime @default(now())

  parent        categories?    @relation("subcategorias", fields: [parent_id], references: [id], onDelete: Cascade)
  subcategorias categories[]   @relation("subcategorias")
  origen        categories?    @relation("copias", fields: [origen_id], references: [id], onDelete: SetNull)
  copias        categories[]   @relation("copias")
  transactions  transactions[]
  budgets       budgets[]
  deudas        debts[]        @relation("deuda_categoria")
  repartos      repartos[]     @relation("reparto_categoria")

  @@index([user_id])
  @@index([origen_id])
}

model transactions {
  id                String   @id @default(uuid()) @db.Uuid
  user_id           String   @db.Uuid
  wallet_id         String   @db.Uuid
  category_id       String?  @db.Uuid
  wallet_destino_id String?  @db.Uuid
  monto             Decimal  @db.Decimal(19, 4)
  tipo              String
  descripcion       String?
  moneda            String?
  monto_original    Decimal? @db.Decimal(19, 4)
  tasa_cambio       Decimal? @db.Decimal(19, 8)
  debt_id           String?  @db.Uuid
  // Une las dos piernas de una transferencia. Sin esto había que adivinar cuál
  // era la pareja de un movimiento para poder borrarlas juntas.
  transfer_id       String?  @db.Uuid
  fecha             DateTime @db.Date
  created_at        DateTime @default(now())

  wallet         wallets     @relation("wallet", fields: [wallet_id], references: [id], onDelete: Cascade)
  wallet_destino wallets?    @relation("wallet_destino", fields: [wallet_destino_id], references: [id], onDelete: SetNull)
  category       categories? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  debt           debts?      @relation(fields: [debt_id], references: [id], onDelete: SetNull)

  @@index([user_id, fecha])
  @@index([wallet_id])
  @@index([category_id])
  @@index([debt_id])
  @@index([transfer_id])
}

model budgets {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  category_id  String   @db.Uuid
  monto_limite Decimal  @db.Decimal(19, 4)
  mes          Int
  anio         Int      @map("ano")
  created_at   DateTime @default(now())

  category categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category_id, mes, anio])
  @@index([user_id])
}

model budget_rollovers {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  mes        Int
  anio       Int      @map("ano")
  created_at DateTime @default(now())

  @@unique([user_id, mes, anio])
  @@index([user_id])
}

model metas {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  nombre         String
  icono          String?
  color          String?
  monto_objetivo Decimal   @db.Decimal(19, 4)
  monto_actual   Decimal   @default(0) @db.Decimal(19, 4)
  fecha_limite   DateTime? @db.Date
  completada     Boolean   @default(false)
  created_at     DateTime  @default(now())

  aportes meta_aportes[]

  @@index([user_id])
}

// Historial de aportes a una meta. Cada aporte mueve dinero de verdad: es una
// transferencia de la cartera de origen a la cartera donde se guarda el ahorro,
// enlazada por transfer_id. Antes "aportar" solo subía un número en metas.
model meta_aportes {
  id                String   @id @default(uuid()) @db.Uuid
  meta_id           String   @db.Uuid
  user_id           String   @db.Uuid
  wallet_id         String?  @db.Uuid
  wallet_destino_id String?  @db.Uuid
  transfer_id       String?  @db.Uuid
  monto             Decimal  @db.Decimal(19, 4)
  fecha             DateTime @db.Date
  nota              String?
  created_at        DateTime @default(now())

  meta metas @relation(fields: [meta_id], references: [id], onDelete: Cascade)

  @@index([meta_id])
  @@index([user_id])
}

model debts {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  nombre       String
  descripcion  String?
  tipo         String
  monto_total  Decimal   @db.Decimal(19, 4)
  monto_pagado Decimal   @default(0) @db.Decimal(19, 4)
  fecha_limite DateTime? @db.Date
  fecha_inicio DateTime? @db.Date
  tasa_interes Decimal?  @db.Decimal(9, 4)
  tasa_periodo String?
  plazo_meses  Int?
  completada   Boolean   @default(false)
  category_id  String?   @db.Uuid
  created_at   DateTime  @default(now())

  payments     debt_payments[]
  transactions transactions[]
  category     categories?     @relation("deuda_categoria", fields: [category_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([category_id])
}

model debt_payments {
  id             String   @id @default(uuid()) @db.Uuid
  debt_id        String   @db.Uuid
  user_id        String   @db.Uuid
  wallet_id      String?  @db.Uuid
  // Transacción de gasto que refleja este abono. Permite deshacerlo entero.
  transaction_id String?  @db.Uuid
  monto          Decimal  @db.Decimal(19, 4)
  fecha          DateTime @db.Date
  nota           String?
  created_at     DateTime @default(now())

  debt   debts    @relation(fields: [debt_id], references: [id], onDelete: Cascade)
  wallet wallets? @relation(fields: [wallet_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([debt_id])
}

model subscriptions {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid
  nombre        String
  plan          String?
  // 'gasto' (suscripción clásica) o 'ingreso' (sueldo, renta, mesada...).
  // Es el mismo mecanismo de recurrencia: cambia el signo del movimiento.
  tipo          String    @default("gasto")
  monto         Decimal   @db.Decimal(19, 4)
  moneda        String    @default("HNL")
  frecuencia    String    @default("mensual")
  category_id   String?   @db.Uuid
  wallet_id     String?   @db.Uuid
  fecha_inicio  DateTime  @db.Date
  proximo_cobro DateTime? @db.Date
  estado        String    @default("activa")
  color         String?
  icono         String?
  notas         String?
  created_at    DateTime  @default(now())

  cobros subscription_charges[]

  @@index([user_id])
}

// Cobros confirmados de una suscripción. Una suscripción por sí sola no mueve
// dinero: hasta que se confirma un cobro no existe el gasto. La unicidad por
// (suscripción, fecha) impide cobrar dos veces el mismo ciclo.
model subscription_charges {
  id              String   @id @default(uuid()) @db.Uuid
  subscription_id String   @db.Uuid
  user_id         String   @db.Uuid
  wallet_id       String?  @db.Uuid
  transaction_id  String?  @db.Uuid
  monto           Decimal  @db.Decimal(19, 4)
  moneda          String   @default("HNL")
  fecha           DateTime @db.Date
  created_at      DateTime @default(now())

  subscription subscriptions @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@unique([subscription_id, fecha])
  @@index([user_id])
}

// Avisos descartados por el usuario. Los avisos se calculan al vuelo (no se
// almacenan), así que para poder ocultarlos se guarda la marca de descarte.
// `periodo` hace que el aviso vuelva a aparecer el siguiente ciclo: descartar
// "presupuesto de comida al 90%" en julio no debe silenciarlo en agosto.
model notificaciones_descartadas {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  clave      String
  periodo    String
  created_at DateTime @default(now())

  @@unique([user_id, clave, periodo])
  @@index([user_id])
}

model grupos {
  id                String   @id @default(uuid()) @db.Uuid
  nombre            String
  moneda            String   @default("USD")
  icono             String   @default("👥")
  color             String   @default("#2c6e49")
  codigo_invitacion String   @unique
  creado_por        String   @db.Uuid
  created_at        DateTime @default(now())

  miembros      grupo_miembros[]
  gastos        gastos_compartidos[]
  liquidaciones liquidaciones[]
}

model grupo_miembros {
  id         String   @id @default(uuid()) @db.Uuid
  grupo_id   String   @db.Uuid
  user_id    String   @db.Uuid
  rol        String   @default("miembro")
  estado     String   @default("activo")
  created_at DateTime @default(now())

  grupo grupos @relation(fields: [grupo_id], references: [id], onDelete: Cascade)

  @@unique([grupo_id, user_id])
  @@index([user_id])
}

model gastos_compartidos {
  id              String   @id @default(uuid()) @db.Uuid
  grupo_id        String   @db.Uuid
  descripcion     String
  monto_total     Decimal  @db.Decimal(19, 4)
  fecha           DateTime @db.Date
  mes             Int
  anio            Int
  category_id     String?  @db.Uuid
  recibo_url      String?
  metodo_division String
  creado_por      String   @db.Uuid
  created_at      DateTime @default(now())

  grupo      grupos             @relation(fields: [grupo_id], references: [id], onDelete: Cascade)
  pagos      gasto_pagos[]
  divisiones gasto_divisiones[]

  @@index([grupo_id, anio, mes])
}

model gasto_pagos {
  id             String  @id @default(uuid()) @db.Uuid
  gasto_id       String  @db.Uuid
  user_id        String  @db.Uuid
  wallet_id      String? @db.Uuid
  transaction_id String? @db.Uuid
  monto          Decimal @db.Decimal(19, 4)

  gasto gastos_compartidos @relation(fields: [gasto_id], references: [id], onDelete: Cascade)

  @@index([gasto_id])
  @@index([user_id])
}

model gasto_divisiones {
  id             String   @id @default(uuid()) @db.Uuid
  gasto_id       String   @db.Uuid
  user_id        String   @db.Uuid
  monto_asignado Decimal  @db.Decimal(19, 4)
  valor          Decimal? @db.Decimal(19, 4)

  gasto gastos_compartidos @relation(fields: [gasto_id], references: [id], onDelete: Cascade)

  @@index([gasto_id])
  @@index([user_id])
}

model liquidaciones {
  id                String   @id @default(uuid()) @db.Uuid
  grupo_id          String   @db.Uuid
  de_user_id        String   @db.Uuid
  a_user_id         String   @db.Uuid
  monto             Decimal  @db.Decimal(19, 4)
  fecha             DateTime @db.Date
  nota              String?
  de_wallet_id      String?  @db.Uuid
  de_transaction_id String?  @db.Uuid
  a_wallet_id       String?  @db.Uuid
  a_transaction_id  String?  @db.Uuid
  created_at        DateTime @default(now())

  grupo grupos @relation(fields: [grupo_id], references: [id], onDelete: Cascade)

  @@index([grupo_id])
}

model repartos {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  descripcion    String
  // Establecimiento donde se hizo el gasto ("Pizza Hut"), separado del
  // concepto ("Pizza"). Va en el reporte de liquidación.
  lugar          String?
  monto_total    Decimal   @db.Decimal(19, 4)
  moneda         String    @default("HNL")
  metodo         String    @default("igual") // 'igual' | 'manual'
  fecha          DateTime  @db.Date
  // Quién puso el dinero. Null = lo pagaste tú (caso por defecto). Con nombre,
  // pagó otra persona: no sale nada de tus carteras y tu parte pasa a ser una
  // deuda con quien pagó.
  pagado_por     String?
  // Cómo se pagó: 'efectivo' | 'tarjeta' | 'transferencia' | 'otro'.
  metodo_pago    String?
  // Detalle legible del método, p. ej. "BAC ••••1234". Se guarda ya resuelto
  // para que el reporte no dependa de que la cartera siga existiendo igual.
  metodo_detalle String?
  wallet_id      String?   @db.Uuid // cartera de la que salió el gasto (si pagaste tú)
  transaction_id String?   @db.Uuid // transacción de gasto asociada
  // Categoría del reparto, siempre de tipo gasto. La heredan las dos patas: el
  // gasto que la registra y cada cobro que la devuelve. Que el cobro lleve la
  // categoría del gasto es lo que permite netear (ver porCategoria en
  // lib/finanzas.ts): así "Suscripciones" refleja lo que Spotify te costó de
  // verdad y no el recibo entero que adelantaste por todos.
  category_id    String?   @db.Uuid
  // Cierre manual: lo que quedó sin cobrar se da por perdido y el reparto deja
  // de contar como pendiente. Null = sigue abierto.
  cerrado_en     DateTime?
  created_at     DateTime  @default(now())

  participantes reparto_participantes[]
  category      categories?             @relation("reparto_categoria", fields: [category_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([category_id])
}

model reparto_participantes {
  id             String    @id @default(uuid()) @db.Uuid
  reparto_id     String    @db.Uuid
  nombre         String
  monto_asignado Decimal   @default(0) @db.Decimal(19, 4)
  pagado         Boolean   @default(false)
  fecha_pago     DateTime? @db.Date
  orden          Int       @default(0)
  es_yo          Boolean   @default(false) // participante es el propio usuario; su parte no se recupera
  wallet_id      String?   @db.Uuid // cartera donde se recibió el cobro
  transaction_id String?   @db.Uuid // transacción de ingreso del cobro

  reparto repartos @relation(fields: [reparto_id], references: [id], onDelete: Cascade)

  @@index([reparto_id])
}
